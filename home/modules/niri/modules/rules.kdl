layer-rule {
  match namespace="^noctalia-wallpaper"
  place-within-backdrop true
}

window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

window-rule {
  match app-id="librewolf"
  open-maximized true
  open-on-workspace "browser"
}

window-rule {
  match app-id="kitty"
  open-on-workspace "code"
}

window-rule {
  match app-id="steam"
  open-on-workspace "games"
  open-maximized true
}

window-rule {
  match app-id="telegram"
  open-on-workspace "chats"
}

window-rule {
  background-effect {
    blur true 
    xray true 
  }
}

blur {
  passes 2        // more passes = stronger blur (default: 3)
  offset 3.0      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}

window-rule {
  match app-id="chromium-browser"
  open-maximized true
  open-on-workspace "browser"
}

window-rule {
  match app-id="zen-beta"
  open-maximized true
  open-on-workspace "browser"
}

window-rule {
  match app-id="Spotify"
  open-maximized true
  open-on-workspace "music"
}
